datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Patient {
  id                        String   @id @default(uuid())
  nombre                    String   @db.VarChar(150)
  telefono                  String   @db.VarChar(20)
  edad                      Int
  examenes_sangre_validados Boolean       @default(false)
  evidencia_archivo_nombre  String?       @db.VarChar(255)
  evidencia_archivo_url     String?       @db.Text
  parametros_hematologicos  String?       @db.Text
  fecha_validacion_examenes DateTime?
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt
  appointments              Appointment[]
  antecedente_medico        AntecedenteMedico?
  medical_history_audits    MedicalHistoryAudit[]

  @@map("patients")
}

enum EstadoCita {
  PROGRAMADA
  ATENDIDA
  CANCELADA

  @@map("estado_cita")
}

model Appointment {
  id           String      @id @default(uuid())
  patient_id   String
  patient      Patient     @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  motivo       String      @db.VarChar(200)
  fecha_inicio DateTime
  fecha_fin    DateTime
  estado       EstadoCita  @default(PROGRAMADA)
  monto_pagado Decimal?    @db.Decimal(10, 2)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@index([fecha_inicio])
  @@map("appointments")
}

enum TipoDiabetes {
  TIPO_1
  TIPO_2
  GESTACIONAL
  OTRO

  @@map("tipo_diabetes")
}

model AntecedenteMedico {
  id                   String        @id @default(uuid())
  patient_id           String        @unique
  patient              Patient       @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  tiene_diabetes       Boolean       @default(false)
  tipo_diabetes        TipoDiabetes?
  tiene_hipertension   Boolean       @default(false)
  tiene_cardiopatia    Boolean       @default(false)
  toma_anticoagulantes Boolean       @default(false)
  esta_embarazada      Boolean       @default(false)
  alergias             String[]      @default([])
  medicacion_actual    String?       @db.Text
  otras_condiciones    String?       @db.Text
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  @@map("antecedentes_medicos")
}

model MedicalHistoryAudit {
  id             String   @id @default(uuid())
  patient_id     String
  patient        Patient  @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  campo          String   @db.VarChar(100)
  valor_anterior String?  @db.Text
  valor_nuevo    String?  @db.Text
  motivo         String   @db.Text
  usuario_id     String?  @db.VarChar(100)
  fecha_hora     DateTime @default(now())

  @@index([patient_id])
  @@map("medical_history_audits")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(150)
  password     String   @db.VarChar(255)
  nombre       String   @db.VarChar(150)
  especialidad String   @default("Odontología General") @db.VarChar(100)
  rol          String   @default("ODONTOLOGO") @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("users")
}
